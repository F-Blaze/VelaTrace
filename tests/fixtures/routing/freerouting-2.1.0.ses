(session "simple-test"
  (base_design "simple-test")
  (placement
    (resolution um 10)
    (component TestPad
      (place J1 50000 100000 front 0)
      (place J2 250000 100000 front 0)
    )
  )
  (was_is
  )
  (routes 
    (resolution um 10)
    (parser
      (host_cad KiCad)
      (host_version 9.0)
    )
    (library_out 
      (padstack "Via[0-1]_600:300_um"
        (shape
          (circle F.Cu 6000 0 0)
        )
        (shape
          (circle B.Cu 6000 0 0)
        )
        (attach off)
      )
      (padstack "Via[0-1]_600:300_um"
        (shape
          (circle F.Cu 6000 0 0)
        )
        (shape
          (circle B.Cu 6000 0 0)
        )
        (attach off)
      )
    )
    (network_out 
      (net N
        (wire
          (path F.Cu 5000
            250000 100000
            50000 100000
          )
        )
      )
    )
  )
)